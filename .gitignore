.venv/
.envs/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/
*.so
*.o
*.a
*.ncu-rep
*.nsys-rep

# Generated run output and local runtimes stay on disk, not in git.
/results/*
# except the results the README cites
!/results/sampler/
!/results/agreement.json
!/results/agreement-8x8.json
!/results/logits/
!/results/stat-cuda.json
!/results/stat-cuda-predicate.json
!/results/gumbel-bound.json
!/results/sanitizer/
/results/sanitizer/*
!/results/sanitizer/summary.json
# engine runs: their JSON and GPU-state files, not the engine logs
!/results/integration/
!/results/e2e/
!/results/determinism/
/results/**/logs/
/.runtime/
